---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import HeroMedia from "../components/HeroMedia.astro";
import TrustStrip from "../components/TrustStrip.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PuppyGrid from "../components/PuppyGrid.astro";
import BellaFeature from "../components/BellaFeature.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { DAILY_LIFE_COPY, NAME_ORIGIN_COPY } from "../data/content";
import { getFeaturedAvailablePuppies } from "../data/puppies";

const featuredPuppies = getFeaturedAvailablePuppies(3);
---

<BaseLayout
  title="Angel Bulldogs | Home-Raised French Bulldogs in Chicago"
  description="Angel Bulldogs is a small, family-guided French Bulldog program in Chicago. Meet Bella and her first litter, raised with personal care."
  path="/"
>
  <section class="hero">
    <HeroMedia />
    <div class="container hero__content">
      <p class="eyebrow">Angel Bulldogs · Chicago</p>
      <h1>It started with Bella.</h1>
      <p class="lede">{NAME_ORIGIN_COPY}</p>
      <div class="cluster hero__actions">
        <ButtonLink href="/puppies">Meet the puppies</ButtonLink>
        <ButtonLink href="/bella" variant="secondary">Bella's story</ButtonLink>
      </div>
    </div>
  </section>

  <TrustStrip />

  <section class="section">
    <div class="container">
      <div class="reveal" data-reveal>
        <SectionHeading
          eyebrow="Available now"
          title="Meet our puppies"
          lede="Five personalities from Bella's first litter. Open a profile for photos, facts, and a short inquiry."
        />
      </div>
      <div class="reveal" data-reveal>
        <PuppyGrid puppies={featuredPuppies} />
      </div>
      {
        featuredPuppies.length > 0 && (
          <p class="cluster reveal" data-reveal>
            <ButtonLink href="/puppies" variant="secondary">View all available puppies</ButtonLink>
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container reveal" data-reveal>
      <SectionHeading title="A day with our puppies" />
      {DAILY_LIFE_COPY.map((paragraph) => <p class="measure">{paragraph}</p>)}
    </div>
  </section>

  <BellaFeature />
  <ProcessSteps />

  <CtaBanner />
</BaseLayout>
