---
import type { FaqItem } from "../data/types";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-item" id={item.id}>
        <summary>{item.question}</summary>
        <div class="faq-item__body">
          {item.answer.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </details>
    ))
  }
</div>
