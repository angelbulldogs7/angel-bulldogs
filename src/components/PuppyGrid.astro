---
import type { Puppy } from "../data/types";
import { PRICE_LABEL } from "../config/site";
import PuppyCard from "./PuppyCard.astro";
import ButtonLink from "./ButtonLink.astro";

interface Props {
  puppies: Puppy[];
}

const { puppies } = Astro.props;
---

{
  puppies.length === 0 ? (
    <div class="empty-state">
      <h2>No puppies are listed right now</h2>
      <p>
        Availability changes. You can still send a short inquiry for a future litter, or contact us
        with a general question.
      </p>
      <div class="cluster">
        <ButtonLink href="/application?puppy=future-litter">Inquire about a future litter</ButtonLink>
        <ButtonLink href="/contact" variant="secondary">Contact</ButtonLink>
      </div>
    </div>
  ) : (
    <div class="puppy-grid-block">
      <p class="price-note measure">{PRICE_LABEL}</p>
      <div class="puppy-grid" data-puppy-grid>
        {puppies.map((puppy) => (
          <PuppyCard puppy={puppy} />
        ))}
      </div>
    </div>
  )
}

{
  puppies.length > 0 && (
    <script>
      import "../scripts/puppy-gallery";
    </script>
  )
}
