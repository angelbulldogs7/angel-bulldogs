---
import { siteConfig } from "../config/site";

interface Props {
  showHandle?: boolean;
}

const { showHandle = false } = Astro.props;
const instagram = siteConfig.socialLinks.instagram;
---

{
  instagram && (
    <a
      class="instagram-link"
      href={instagram.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Angel Bulldogs on Instagram, ${instagram.handle} (opens in a new tab)`}
    >
      <svg
        class="instagram-link__icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
      </svg>
      <span>{showHandle ? instagram.handle : "Instagram"}</span>
    </a>
  )
}

<style>
  .instagram-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    max-width: 100%;
    text-decoration: none;
    color: var(--color-cocoa);
    border-radius: var(--radius-sm);
  }

  .instagram-link__icon {
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
  }

  .instagram-link span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .instagram-link:hover span,
  .instagram-link:focus-visible span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
