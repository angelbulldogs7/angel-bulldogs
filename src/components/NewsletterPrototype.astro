---
import { siteConfig } from "../config/site";

const newsletterEndpoint = "/api/newsletter";
---

<form
  class="newsletter"
  data-newsletter-form
  data-prototype-mode={siteConfig.prototypeMode ? "true" : "false"}
  data-endpoint={newsletterEndpoint}
  action={newsletterEndpoint}
  method="post"
>
  <div class="newsletter-row">
    <div class="field" data-field>
      <label class="field__label" for="newsletter-email">Email</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="you@example.com"
        aria-describedby="newsletter-hint"
      />
    </div>
    <button class="btn btn--primary" type="submit">
      <span>Join the list</span>
    </button>
  </div>
  <div class="newsletter-feedback">
    <p class="field__hint" id="newsletter-hint">
      You can unsubscribe at any time. Joining does not reserve a puppy.
    </p>
    <p class="field__error" data-error id="newsletter-email-error" hidden></p>
    <p class="prototype-banner" data-form-notice role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { decideFormDelivery, postNewsletterSignup } from "../lib/formDelivery";

  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const notice = form?.querySelector<HTMLElement>("[data-form-notice]");
  const error = form?.querySelector<HTMLElement>("[data-error]");
  const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && notice && emailInput) {
    // Enable custom validation only after enhancement is ready.
    form.setAttribute("novalidate", "");

    const setFieldError = (message: string | null) => {
      if (!error) return;
      if (message) {
        error.textContent = message;
        error.hidden = false;
        emailInput.setAttribute("aria-invalid", "true");
        emailInput.setAttribute(
          "aria-describedby",
          ["newsletter-hint", "newsletter-email-error"].join(" "),
        );
      } else {
        error.textContent = "";
        error.hidden = true;
        emailInput.removeAttribute("aria-invalid");
        emailInput.setAttribute("aria-describedby", "newsletter-hint");
      }
    };

    const showNotice = (message: string, tone: "info" | "success" | "error") => {
      notice.dataset.tone = tone;
      notice.classList.add("is-visible");
      notice.textContent = message;
    };

    let sending = false;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending) return;

      if (!emailInput.validity.valid) {
        setFieldError(
          emailInput.validity.valueMissing ? "This field is required." : "Please enter a valid email address.",
        );
        emailInput.focus();
        return;
      }
      setFieldError(null);

      const decision = decideFormDelivery({
        endpoint: form.dataset.endpoint || null,
        prototypeMode: form.dataset.prototypeMode === "true",
      });
      if (decision.action === "unavailable") {
        showNotice(
          "Newsletter signup is temporarily unavailable. Please try again later, or use Contact.",
          "info",
        );
        return;
      }

      sending = true;
      form.setAttribute("aria-busy", "true");
      if (submitButton) submitButton.disabled = true;
      showNotice("Sending…", "info");

      const result = await postNewsletterSignup(decision.endpoint, emailInput.value.trim());
      if (result.ok && result.state === "confirmation_pending") {
        // Keep the address so the visitor can check spam without retyping.
        showNotice(result.message, "success");
      } else if (result.ok) {
        form.reset();
        showNotice(result.message, "success");
      } else if (result.state === "invalid") {
        setFieldError(result.message);
        showNotice(result.message, "error");
        emailInput.focus();
      } else {
        showNotice(result.message, result.state === "unavailable" ? "info" : "error");
      }

      sending = false;
      form.removeAttribute("aria-busy");
      if (submitButton) submitButton.disabled = false;
    });
  }
</script>
