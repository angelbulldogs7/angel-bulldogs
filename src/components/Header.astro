---
interface Props {
  currentPath: string;
}

import { siteConfig } from "../config/site";
import { isCurrentPath } from "../utils/format";
import AnnouncementBar from "./AnnouncementBar.astro";
import ButtonLink from "./ButtonLink.astro";
import TextWordmark from "./TextWordmark.astro";

const { currentPath } = Astro.props;
---

<header class="site-header" data-site-header>
  <AnnouncementBar />
  <div class="container header-inner">
    <TextWordmark />
    <nav class="desktop-nav" aria-label="Primary">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class:list={{ "desktop-nav__link--badged": "badge" in item && !!item.badge }}
            aria-current={isCurrentPath(currentPath, item.href) ? "page" : undefined}
          >
            <span>{item.label}</span>
            {"badge" in item && item.badge ? <span class="nav-badge">{item.badge}</span> : null}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <ButtonLink href="/puppies" class="btn--header">View Puppies</ButtonLink>
      <button
        class="menu-toggle"
        type="button"
        data-nav-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Drawer and overlay are body-level siblings so header backdrop-filter cannot trap fixed positioning. -->
<div class="nav-overlay" data-nav-overlay hidden></div>
<div
  class="mobile-drawer"
  id="mobile-nav"
  data-nav-drawer
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  aria-hidden="true"
  inert
  tabindex="-1"
>
  <div class="drawer-head">
    <TextWordmark />
    <button class="drawer-close" type="button" data-nav-close aria-label="Close menu">
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <nav aria-label="Mobile">
    {
      siteConfig.mobileNav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrentPath(currentPath, item.href) ? "page" : undefined}
        >
          <span>{item.label}</span>
          {"badge" in item && item.badge ? <span class="nav-badge">{item.badge}</span> : null}
        </a>
      ))
    }
  </nav>
  <ButtonLink href="/puppies">View Puppies</ButtonLink>
</div>

<script>
  import "../scripts/mobile-nav";
</script>

<style>
  .desktop-nav__link--badged {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.15rem;
  }

  .desktop-nav__link--badged .nav-badge {
    margin-left: 0;
    padding: 0.08rem 0.35rem;
    font-size: 0.55rem;
    line-height: 1.25;
  }
</style>
