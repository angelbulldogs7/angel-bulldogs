---
import { ACKNOWLEDGEMENTS } from "../../lib/color-lab/safetyRules";
---

<dialog class="cl-drawer" data-interest-drawer aria-labelledby="cl-interest-title">
  <div class="cl-drawer__sheet">
    <header class="cl-drawer__head">
      <h2 id="cl-interest-title">I’m interested in this puppy</h2>
      <button class="drawer-close" type="button" data-dialog-close aria-label="Close interest form">
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="cl-drawer__context" data-interest-context></div>
    <form class="form cl-interest-form" data-interest-form novalidate>
      <p class="cl-honeypot" aria-hidden="true">
        <label>
          Company
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
      </p>
      <div class="form-grid form-grid--2">
        <div class="field full" data-field>
          <label class="field__label" for="cl-full-name">Full name</label>
          <input id="cl-full-name" name="fullName" type="text" autocomplete="name" maxlength="120" required aria-describedby="cl-full-name-error" />
          <p class="field__error" id="cl-full-name-error" data-error hidden></p>
        </div>
        <div class="field" data-field>
          <label class="field__label" for="cl-email">Email</label>
          <input id="cl-email" name="email" type="email" autocomplete="email" maxlength="160" required aria-describedby="cl-email-error" />
          <p class="field__error" id="cl-email-error" data-error hidden></p>
        </div>
        <div class="field" data-field>
          <label class="field__label" for="cl-phone">Phone</label>
          <input id="cl-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" pattern="[0-9+().\s-]{7,}" required aria-describedby="cl-phone-error" />
          <p class="field__error" id="cl-phone-error" data-error hidden></p>
        </div>
        <div class="field" data-field>
          <label class="field__label" for="cl-city">City</label>
          <input id="cl-city" name="city" type="text" autocomplete="address-level2" maxlength="80" required aria-describedby="cl-city-error" />
          <p class="field__error" id="cl-city-error" data-error hidden></p>
        </div>
        <div class="field" data-field>
          <label class="field__label" for="cl-state">State</label>
          <input id="cl-state" name="state" type="text" autocomplete="address-level1" maxlength="40" required aria-describedby="cl-state-error" />
          <p class="field__error" id="cl-state-error" data-error hidden></p>
        </div>
        <div class="field full" data-field>
          <label class="field__label" for="cl-timeframe">Desired timeframe</label>
          <select id="cl-timeframe" name="timeframe" required aria-describedby="cl-timeframe-error">
            <option value="">Select one</option>
            <option value="0-3 months">0–3 months</option>
            <option value="3-6 months">3–6 months</option>
            <option value="6-12 months">6–12 months</option>
            <option value="Just exploring">Just exploring</option>
          </select>
          <p class="field__error" id="cl-timeframe-error" data-error hidden></p>
        </div>
      </div>
      <fieldset class="cl-acks" data-acks hidden>
        <legend class="field__label">Please read and acknowledge</legend>
        <label class="check" data-ack-row="hairless" hidden>
          <input type="checkbox" name="ack-hairless" data-ack="hairless" />
          <span>{ACKNOWLEDGEMENTS.hairless.label}</span>
        </label>
        <label class="check" data-ack-row="pink" hidden>
          <input type="checkbox" name="ack-pink" data-ack="pink" />
          <span>{ACKNOWLEDGEMENTS.pink.label}</span>
        </label>
        <p class="field__error" data-ack-error hidden></p>
      </fieldset>
      <div class="cl-consent" data-field>
        <label class="check">
          <input type="checkbox" name="consent" required aria-describedby="cl-consent-error" />
          <span>I understand this is an interest inquiry, not a reservation or purchase.</span>
        </label>
        <p class="field__error" id="cl-consent-error" data-error hidden></p>
      </div>
      <p class="field__hint">
        We use these details only to follow up about this puppy interest. Please do not include a
        street address.
      </p>
      <p class="cl-form-status" data-interest-status role="status" aria-live="polite" hidden></p>
      <button class="btn btn--primary" type="submit" data-interest-submit>Send interest</button>
    </form>
  </div>
</dialog>
