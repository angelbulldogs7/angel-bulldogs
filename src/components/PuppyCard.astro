---
import type { Puppy } from "../data/types";
import { PRICE_LABEL } from "../config/site";
import { formatEstimatedCarriers, formatPuppyStatus, formatSex } from "../utils/format";
import ButtonLink from "./ButtonLink.astro";
import MediaImage from "./MediaImage.astro";

interface Props {
  puppy: Puppy;
}

const { puppy } = Astro.props;
const titleId = `puppy-title-${puppy.slug}`;
const cardId = `puppy-${puppy.slug}`;
const detailHref = `/puppies/${puppy.slug}`;
const gallery = [puppy.primaryImage, ...puppy.gallery.filter((asset) => asset.src !== puppy.primaryImage.src)];
const statusLabel = formatPuppyStatus(puppy.status);
const canInquire = puppy.status === "available";
const carrierLabel = formatEstimatedCarriers(puppy.estimatedCarrierTraits);
const hasGallery = gallery.length > 1;
const galleryJson = JSON.stringify(
  gallery.map((asset) => ({
    src: asset.src,
    alt: asset.alt,
    width: asset.width,
    height: asset.height,
  })),
);
---

<article
  class="puppy-card"
  id={cardId}
  data-puppy-card
  data-puppy-name={puppy.name}
  data-puppy-gallery
  data-gallery={galleryJson}
>
  <div class="puppy-card__summary">
    <div class="puppy-card__media" data-gallery-stage>
      <a class="puppy-card__photo-link" href={detailHref} aria-labelledby={titleId}>
        <MediaImage
          class="puppy-card__photo puppy-card__photo--primary"
          data-gallery-main
          src={gallery[0].src}
          alt={gallery[0].alt}
          width={gallery[0].width}
          height={gallery[0].height}
        />
      </a>
      {
        hasGallery && (
          <div class="puppy-card__gallery-nav" data-gallery-controls>
            <button
              type="button"
              class="puppy-card__gallery-btn"
              data-gallery-prev
              aria-label={`Previous photo of ${puppy.name}`}
            >
              ‹
            </button>
            <p class="puppy-card__gallery-count" data-gallery-count aria-live="polite">
              1 / {gallery.length}
            </p>
            <button
              type="button"
              class="puppy-card__gallery-btn"
              data-gallery-next
              aria-label={`Next photo of ${puppy.name}`}
            >
              ›
            </button>
          </div>
        )
      }
    </div>
    <div class="puppy-card__body">
      <div class="cluster">
        <span class:list={["status-pill", puppy.status !== "available" && "status-pill--muted"]}>
          {statusLabel}
        </span>
        {puppy.placeholder && <span class="dev-notice">Placeholder record</span>}
      </div>
      <h3 class="puppy-card__title" id={titleId}>
        <a class="puppy-card__title-link" href={detailHref}>{puppy.name}</a>
      </h3>
      <div class="puppy-card__meta">
        <span>{formatSex(puppy.sex)}</span>
        <span>{puppy.color}</span>
        <span>{puppy.coatType}</span>
      </div>
      {puppy.shortDescription && <p>{puppy.shortDescription}</p>}
      {carrierLabel && <p class="field__hint">{carrierLabel}</p>}
      <p class="price-note">{PRICE_LABEL}</p>
      <div class="puppy-card__actions">
        <ButtonLink href={detailHref} variant="secondary">
          View details
        </ButtonLink>
        {
          canInquire ? (
            <ButtonLink href={`/application?puppy=${puppy.slug}`} variant="ghost">
              Inquire about {puppy.name}
            </ButtonLink>
          ) : (
            <ButtonLink href="/application?puppy=undecided" variant="ghost">
              Ask about future availability
            </ButtonLink>
          )
        }
      </div>
    </div>
  </div>
</article>
