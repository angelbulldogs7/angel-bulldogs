---
import { getPublicEmail, siteConfig } from "../config/site";
import { getAvailablePuppyOptions } from "../data/puppies";
import { parseFormspreeEndpoint } from "../lib/formDelivery";

const puppies = getAvailablePuppyOptions();
const formspreeEndpoint = parseFormspreeEndpoint(import.meta.env.PUBLIC_FORMSPREE_CONTACT_ENDPOINT);
const publicEmail = getPublicEmail().address ?? "angelbulldogs7@gmail.com";
---

<form
  class="form"
  data-contact-form
  data-prototype-mode={siteConfig.prototypeMode ? "true" : "false"}
  data-endpoint={formspreeEndpoint ?? ""}
  data-public-email={publicEmail}
  action={formspreeEndpoint ?? undefined}
  method={formspreeEndpoint ? "post" : undefined}
>
  <p class="field__hint" id="contact-required-note">Required fields are marked with an asterisk (*).</p>
  <fieldset class="fieldset">
    <legend>Send a note</legend>
    <div class="form-grid form-grid--2">
      <div class="field" data-field>
        <label class="field__label" for="contact-name">Name <span aria-hidden="true">*</span></label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required aria-required="true" />
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="contact-email">Email <span aria-hidden="true">*</span></label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required aria-required="true" />
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="topic">Topic <span aria-hidden="true">*</span></label>
        <select id="topic" name="topic" data-contact-topic required aria-required="true">
          <option value="">Select one</option>
          <option value="available-puppy">Available Puppy</option>
          <option value="inquiry">Inquiry Question</option>
          <option value="delivery">Nationwide Delivery</option>
          <option value="breeding-rights">Breeding Rights</option>
          <option value="general">General Question</option>
        </select>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="contact-puppy">Puppy <span class="optional">(optional)</span></label>
        <select id="contact-puppy" name="puppy" data-contact-puppy>
          <option value="">No specific puppy</option>
          {puppies.map((puppy) => <option value={puppy.slug}>{puppy.name}</option>)}
        </select>
        <p class="field__hint" data-unknown-puppy hidden>
          We could not match that puppy to a current listing. You can still send a general note.
        </p>
      </div>
      <div class="field full" data-field>
        <label class="field__label" for="contact-message">Message <span aria-hidden="true">*</span></label>
        <textarea id="contact-message" name="message" required aria-required="true"></textarea>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field full" data-field>
        <label class="check">
          <input type="checkbox" name="contactAck" required aria-required="true" />
          <span>
            I understand this is an inquiry, not a reservation, and Angel Bulldogs will reply using the
            email I provide. <span aria-hidden="true">*</span>
          </span>
        </label>
        <p class="field__error" data-error hidden></p>
      </div>
    </div>
  </fieldset>
  <div>
    <button class="btn btn--primary btn--full-mobile" type="submit">
      <span>Send message</span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
    <p class="field__hint form-privacy-note">
      We use the information you provide to respond to your message.
      See our <a href="/privacy">Privacy Policy</a>.
    </p>
    <p class="prototype-banner" data-form-notice role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { parseFormspreeEndpoint } from "../lib/formDelivery";
  import { initPrototypeForm, syncSelectFromQuery } from "../scripts/prototype-form";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const notice = form?.querySelector<HTMLElement>("[data-form-notice]");
  const puppySelect = form?.querySelector<HTMLSelectElement>("[data-contact-puppy]");
  const topicSelect = form?.querySelector<HTMLSelectElement>("[data-contact-topic]");
  const unknown = form?.querySelector<HTMLElement>("[data-unknown-puppy]");
  const publicEmail = form?.dataset.publicEmail ?? "angelbulldogs7@gmail.com";

  if (form && notice) {
    initPrototypeForm({
      form,
      notice,
      endpoint: parseFormspreeEndpoint(form.dataset.endpoint),
      prototypeMode: form.dataset.prototypeMode === "true",
      unavailableMessage: `Contact delivery is not connected yet, so nothing was sent. Please email ${publicEmail} for now.`,
      successMessage: "Thank you. Your message was sent to Angel Bulldogs. We will follow up by email.",
      errorMessage: `Something went wrong and your message was not sent. Your details are still in the form. Please try again or email ${publicEmail}.`,
    });
  }

  if (puppySelect) {
    syncSelectFromQuery({
      select: puppySelect,
      param: "puppy",
      unknownNotice: unknown ?? undefined,
    });
  }

  // When a valid puppy context is present on Contact, preselect Available Puppy.
  if (topicSelect && puppySelect) {
    const applyTopic = () => {
      const params = new URLSearchParams(window.location.search);
      const puppy = params.get("puppy");
      if (!puppy) return;
      const match = Array.from(puppySelect.options).some((option) => option.value === puppy);
      if (match && !topicSelect.value) {
        topicSelect.value = "available-puppy";
      }
    };
    applyTopic();
    puppySelect.addEventListener("change", () => {
      if (puppySelect.value && !topicSelect.value) {
        topicSelect.value = "available-puppy";
      }
    });
  }
</script>
