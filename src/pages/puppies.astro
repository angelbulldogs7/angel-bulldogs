---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import LitterIntro from "../components/LitterIntro.astro";
import LitterGallery from "../components/LitterGallery.astro";
import LitterAge from "../components/LitterAge.astro";
import PuppyGrid from "../components/PuppyGrid.astro";
import { LISTING_INTRO_COPY } from "../data/content";
import { getListedPuppies } from "../data/puppies";

const listed = getListedPuppies();
---

<BaseLayout
  title="Available French Bulldog Puppies | Angel Bulldogs"
  description="Meet Bella's five French Bulldog puppies, born in Serbia and now with Angel Bulldogs in Chicago. Compare personalities, photos, and current availability."
  path="/puppies"
>
  <PageHero eyebrow="Bella's first litter" title="Available Puppies" lede={LISTING_INTRO_COPY} />
  <section class="section">
    <div class="container stack-lg">
      <LitterAge compact />
      <LitterIntro showGallery={false} />
      <PuppyGrid puppies={listed} />
    </div>
  </section>
  <LitterGallery />
</BaseLayout>
