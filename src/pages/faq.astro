---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { faqGroups } from "../data/faqs";
---

<BaseLayout
  title="French Bulldog Puppy FAQ | Angel Bulldogs"
  description="Answers about Angel Bulldogs’ Chicago French Bulldog program, nationwide delivery, puppy inquiries, pricing, and Bella’s small-program philosophy."
  path="/faq"
>
  <PageHero
    title="Frequently Asked Questions"
    lede="Clear answers to the questions families ask most. If yours is not here, we would rather talk than invent a policy."
  />
  <section class="section">
    <div class="container faq-groups">
      {
        faqGroups.map((group) => (
          <div class="faq-group">
            <h2>{group.title}</h2>
            <FaqAccordion items={group.items} />
          </div>
        ))
      }
    </div>
  </section>
  <CtaBanner
    title="Still have a question?"
    lede="Write to us, or start a short puppy inquiry if you are ready to talk about a future puppy."
  />
</BaseLayout>
