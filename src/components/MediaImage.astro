---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  heroPoster?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading = "lazy",
  fetchpriority = "auto",
  heroPoster = false,
} = Astro.props;
---

<img
  class={className}
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  data-hero-poster={heroPoster ? true : undefined}
/>
