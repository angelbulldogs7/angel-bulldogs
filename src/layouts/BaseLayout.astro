---
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  imageAlt?: string;
  /** Utility pages such as newsletter thanks stay out of search indexes. */
  noindex?: boolean;
}

import { getSiteOrigin, siteConfig } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title, description, path, ogImage: ogImageProp, imageAlt, noindex = false } = Astro.props;
const origin = getSiteOrigin();
const canonical = origin ? `${origin}${path === "/" ? "" : path}` : null;
const ogImagePath = ogImageProp ?? siteConfig.ogImage;
const ogImage = origin ? `${origin}${ogImagePath}` : ogImagePath;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {imageAlt ? <meta property="og:image:alt" content={imageAlt} /> : null}
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt ? <meta name="twitter:image:alt" content={imageAlt} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal";
      import "../scripts/skip-link";
    </script>
  </body>
</html>
