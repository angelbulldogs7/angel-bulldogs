# Public build-time endpoints only (safe to expose in the browser).
# Copy to .env for local testing. Set the same keys in Cloudflare Pages → Settings → Environment variables.

# Formspree — create one form per purpose, then paste each form’s endpoint URL:
# https://formspree.io/f/yourFormId
PUBLIC_FORMSPREE_APPLICATION_ENDPOINT=
PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
PUBLIC_FORMSPREE_COLOR_LAB_ENDPOINT=

# Brevo — Contacts → Forms → create a sign-up form → Embed → Simple HTML → copy the form action URL
# Example: https://xxxx.sibforms.com/serve/MUIFA...
PUBLIC_BREVO_NEWSLETTER_ENDPOINT=
