---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Match a centered form column (e.g. Puppy Inquiry). */
  narrow?: boolean;
}

const { eyebrow, title, lede, narrow = false } = Astro.props;
---

<section class:list={["page-hero", narrow && "page-hero--narrow"]}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede measure">{lede}</p>}
    <slot />
  </div>
</section>
