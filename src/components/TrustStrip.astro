---
import { TRUST_STRIP_ITEMS } from "../data/content";

const items = TRUST_STRIP_ITEMS;
---

<div class="trust-strip container">
  <ul class="trust-grid">
    {
      items.map((item) => (
        <li class="trust-item">
          {item.icon === "home" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4 10.5 12 4l8 6.5V20H4V10.5Z" />
              <path d="M9 20v-7h6v7" />
            </svg>
          )}
          {item.icon === "conversation" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M5 6.5h14v8.5H9l-4 3V6.5Z" />
              <path d="M8 10h8M8 13h5" />
            </svg>
          )}
          {item.icon === "roots" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 3v8" />
              <path d="M12 11c-4 2-6 5-6 9" />
              <path d="M12 11c4 2 6 5 6 9" />
              <path d="M12 15c-2 1-3 2.5-3 5" />
              <path d="M12 15c2 1 3 2.5 3 5" />
            </svg>
          )}
          {item.icon === "map" && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.2" />
            </svg>
          )}
          <p>{item.title}</p>
        </li>
      ))
    }
  </ul>
</div>
