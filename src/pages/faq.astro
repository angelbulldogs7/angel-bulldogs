---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { faqGroups } from "../data/faqs";
---

<BaseLayout
  title="French Bulldog Puppy FAQ | Angel Bulldogs"
  description="Practical answers about Angel Bulldogs holds, deposits, meetings, handover, records, DNA descriptions, support, and rehoming."
  path="/faq"
>
  <PageHero
    title="Frequently Asked Questions"
    lede="Practical answers about placement, meetings, records, and support. If you need anything else, email us."
  />
  <section class="section">
    <div class="container faq-groups">
      {
        faqGroups.map((group) => (
          <div class="faq-group">
            <h2>{group.title}</h2>
            <FaqAccordion items={group.items} />
          </div>
        ))
      }
    </div>
  </section>
  <CtaBanner
    title="Still have a question?"
    lede="Write to us, or start a short puppy inquiry if you are ready to talk about a puppy."
  />
  <script>
    import "../scripts/faq-anchors";
  </script>
</BaseLayout>
