---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import MediaImage from "../components/MediaImage.astro";
import { formatDate } from "../utils/format";
import { displayParentName, getDam, getSire } from "../data/parents";
import {
  BELLA_LITTER_LIMIT_COPY,
  BELLA_PERSONALITY_COPY,
  BELLA_STORY_COPY,
  MENTORSHIP_COPY,
} from "../data/content";

const bella = getDam();
const sire = getSire();
const facts = [
  { label: "Name", value: bella.name },
  { label: "Origin", value: bella.origin },
  { label: "Date of birth", value: bella.dateOfBirth ? formatDate(bella.dateOfBirth) : null },
  { label: "Coat", value: bella.coat },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));

const homeGallery = [
  {
    src: "/images/bella/v5-lifestyle.jpg",
    alt: "Bella sitting on her bed at home in Chicago",
    width: 1200,
    height: 800,
  },
  {
    src: "/images/bella/v5-home-01.jpg",
    alt: "Bella at home interacting with her family",
    width: 1200,
    height: 800,
  },
  {
    src: "/images/bella/v5-home-02.jpg",
    alt: "Bella standing in profile on her bed",
    width: 1200,
    height: 800,
  },
  {
    src: "/images/bella/v5-home-03.jpg",
    alt: "Bella standing and looking upward on her bed",
    width: 1200,
    height: 800,
  },
  {
    src: "/images/bella/v5-home-04.jpg",
    alt: "Bella looking up toward the camera at home",
    width: 1200,
    height: 800,
  },
];
---

<BaseLayout
  title="Meet Bella | Angel Bulldogs"
  description="Meet Bella, the heart of Angel Bulldogs. A French Bulldog from Serbia who shares life with her family in Chicago."
  path="/bella"
  ogImage={bella.portrait?.src}
  imageAlt={bella.portrait?.alt}
>
  <section class="section">
    <div class="container split split--2">
      {
        bella.portrait && (
          <div class="media-frame aspect-portrait">
            <MediaImage
              src={bella.portrait.src}
              alt={bella.portrait.alt}
              width={bella.portrait.width}
              height={bella.portrait.height}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div>
        <p class="eyebrow">The heart of Angel Bulldogs</p>
        <h1>Our angel, Bella</h1>
        {BELLA_STORY_COPY.map((paragraph) => <p class="lede">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container reveal" data-reveal>
      <p class="eyebrow">Bella at a glance</p>
      <h2>A few facts about Bella</h2>
      <dl class="fact-row">
        {
          facts.map((fact) => (
            <div class="fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container measure reveal" data-reveal>
      <p class="eyebrow">Personality</p>
      <h2>Clever, cuddly, and strong-willed</h2>
      <p>{BELLA_PERSONALITY_COPY}</p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container reveal" data-reveal>
      <p class="eyebrow">At home</p>
      <h2>Life with Bella</h2>
      <p class="lede measure">Quiet days in Chicago, and the first litter she raised beside us.</p>
      <div class="gallery">
        {
          homeGallery.map((image) => (
            <div class="media-frame aspect-landscape">
              <MediaImage src={image.src} alt={image.alt} width={image.width} height={image.height} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container measure reveal" data-reveal>
      <p class="eyebrow">Quality over quantity</p>
      <h2>Three litters, chosen with care</h2>
      <p>
        {BELLA_LITTER_LIMIT_COPY} Keeping the program small gives us time to care for the puppies at
        home, learn their personalities, and stay in touch with their families.
      </p>
      <p>
        Bella naturally delivered this litter and comes from a maternal line with a history of
        natural deliveries.
      </p>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container measure reveal" data-reveal>
      <p class="eyebrow">Serbian mentorship</p>
      <h2>Guidance that shaped this program</h2>
      <p>{MENTORSHIP_COPY.short}</p>
      <p>
        Bella's Serbian origin remains part of her story. Angel Bulldogs brings that care into a
        small Chicago home.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container measure reveal" data-reveal>
      <p class="eyebrow">Meet the sire</p>
      <h2>{displayParentName(sire)}</h2>
      {
        sire.intro ? (
          <p>{sire.intro}</p>
        ) : (
          <p>
            {displayParentName(sire)} is the sire of Bella's puppies. Additional details are shared
            during a personal inquiry when they are useful for placement.
          </p>
        )
      }
      {sire.coat && <p>Coat: {sire.coat}</p>}
    </div>
  </section>

  <CtaBanner
    title="Meet Bella's available puppies"
    lede="Explore the litter, or send a short inquiry so we can learn what you are looking for."
  />
</BaseLayout>
