# Public build-time endpoints only (safe to expose in the browser).
# Copy to .env for local testing. Set the same keys in Cloudflare Pages → Settings → Environment variables.

# Formspree — create one form per purpose, then paste each form’s endpoint URL:
# https://formspree.io/f/yourFormId
PUBLIC_FORMSPREE_APPLICATION_ENDPOINT=
PUBLIC_FORMSPREE_CONTACT_ENDPOINT=
PUBLIC_FORMSPREE_COLOR_LAB_ENDPOINT=

# Newsletter uses the same-origin Pages Function at /api/newsletter.
# Do NOT put the Brevo API key in PUBLIC_* variables.
# For local Functions preview, copy the server bindings below into a gitignored .dev.vars file.
#
# BREVO_API_KEY="REPLACE_PRIVATELY"
# BREVO_NEWSLETTER_LIST_IDS="REPLACE_WITH_ACTUAL_LIST_IDS"
# BREVO_NEWSLETTER_MODE="doi"
# BREVO_DOI_TEMPLATE_ID="REPLACE_WITH_ACTUAL_TEMPLATE_ID"
# BREVO_DOI_REDIRECT_URL="https://angelbulldogs.com/newsletter/thanks/"
