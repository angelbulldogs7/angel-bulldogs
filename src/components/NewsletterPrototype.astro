---
import { siteConfig } from "../config/site";
import { parseBrevoFormEndpoint } from "../lib/formDelivery";

const brevoEndpoint = parseBrevoFormEndpoint(import.meta.env.PUBLIC_BREVO_NEWSLETTER_ENDPOINT);
---

<form
  class="newsletter"
  data-newsletter-form
  data-prototype-mode={siteConfig.prototypeMode ? "true" : "false"}
  data-endpoint={brevoEndpoint ?? ""}
  novalidate
>
  <div class="newsletter-row">
    <div class="field" data-field>
      <label class="field__label" for="newsletter-email">Email</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="you@example.com"
      />
      <p class="field__error" data-error hidden></p>
    </div>
    <button class="btn btn--primary" type="submit">
      <span>Join the list</span>
    </button>
  </div>
  <p class="field__hint">
    Subscribers receive availability updates. Joining does not reserve a puppy.
  </p>
  <p class="prototype-banner" data-form-notice role="status" aria-live="polite"></p>
</form>

<script>
  import { parseBrevoFormEndpoint, postBrevoNewsletter } from "../lib/formDelivery";
  import { initPrototypeForm } from "../scripts/prototype-form";

  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const notice = form?.querySelector<HTMLElement>("[data-form-notice]");

  if (form && notice) {
    initPrototypeForm({
      form,
      notice,
      endpoint: parseBrevoFormEndpoint(form.dataset.endpoint),
      prototypeMode: form.dataset.prototypeMode === "true",
      unavailableMessage:
        "Newsletter signup is not connected yet, so nothing was sent. Please check back soon or use Contact.",
      successMessage:
        "You are on the Angel Bulldogs list. Joining does not reserve a puppy; we will share availability updates by email.",
      errorMessage:
        "Something went wrong and you were not added to the list. Your email is still in the form — please try again.",
      submit: async (endpoint, liveForm) => {
        const emailInput = liveForm.querySelector<HTMLInputElement>('input[name="email"]');
        const email = emailInput?.value.trim() ?? "";
        return postBrevoNewsletter(endpoint, email);
      },
    });
  }
</script>
