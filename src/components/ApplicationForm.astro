---
import { getPublicEmail, PRICE_LABEL, siteConfig } from "../config/site";
import { getAvailablePuppyOptions } from "../data/puppies";
import { parseFormspreeEndpoint } from "../lib/formDelivery";
import {
  LOOKING_FOR_OPTIONS,
  PUPPY_INQUIRY_FORM_VERSION,
  PUPPY_INTEREST_FUTURE_LITTER,
  PUPPY_INTEREST_UNDECIDED,
  TIMING_OPTIONS,
} from "../lib/puppyInquiry";

const puppies = getAvailablePuppyOptions();
const formspreeEndpoint = parseFormspreeEndpoint(import.meta.env.PUBLIC_FORMSPREE_APPLICATION_ENDPOINT);
const publicEmail = getPublicEmail().address ?? "angelbulldogs7@gmail.com";
---

<form
  class="form"
  data-application-form
  data-prototype-mode={siteConfig.prototypeMode ? "true" : "false"}
  data-endpoint={formspreeEndpoint ?? ""}
  data-public-email={publicEmail}
  novalidate
>
  <input type="hidden" name="formVersion" value={PUPPY_INQUIRY_FORM_VERSION} />
  <input type="hidden" name="_subject" value="Puppy Inquiry — Angel Bulldogs" />

  <p class="field__hint" id="inquiry-required-note">Required fields are marked with an asterisk (*).</p>
  <p class="field__hint measure">{PRICE_LABEL}</p>

  <fieldset class="fieldset">
    <legend>Puppy inquiry</legend>
    <div class="form-grid form-grid--2">
      <div class="field" data-field>
        <label class="field__label" for="full-name">Name <span aria-hidden="true">*</span></label>
        <input
          id="full-name"
          name="fullName"
          type="text"
          autocomplete="name"
          required
          aria-required="true"
          aria-describedby="inquiry-required-note"
        />
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="email">Email <span aria-hidden="true">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" required aria-required="true" />
        <p class="field__hint">We’ll reply by email.</p>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field full" data-field>
        <label class="field__label" for="location">City and state <span aria-hidden="true">*</span></label>
        <input
          id="location"
          name="location"
          type="text"
          autocomplete="address-level2"
          required
          aria-required="true"
          placeholder="Chicago, IL"
        />
        <p class="field__hint">City and state only — no street address or ZIP needed here.</p>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field full" data-field>
        <label class="field__label" for="puppy">Which puppy interests you? <span aria-hidden="true">*</span></label>
        <select id="puppy" name="puppyInterest" data-puppy-select required aria-required="true">
          <option value="">Select one</option>
          {
            puppies.map((puppy) => (
              <option value={puppy.slug}>{puppy.name}</option>
            ))
          }
          <option value={PUPPY_INTEREST_UNDECIDED}>No specific puppy yet — help me choose</option>
          <option value={PUPPY_INTEREST_FUTURE_LITTER}>Future litter</option>
        </select>
        <p class="field__hint" data-unknown-puppy hidden>
          We could not match that puppy to a current listing. Please choose from the options below, or select help me choose / future litter.
        </p>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="timing">When would you like to welcome a puppy? <span aria-hidden="true">*</span></label>
        <select id="timing" name="timing" required aria-required="true">
          <option value="">Select one</option>
          {TIMING_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="looking-for">What are you looking for? <span aria-hidden="true">*</span></label>
        <select id="looking-for" name="lookingFor" data-looking-for required aria-required="true">
          <option value="">Select one</option>
          {LOOKING_FOR_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <p class="field__hint" data-breeding-note hidden>
          Breeding rights are discussed individually and are not automatically included.
        </p>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field" data-field>
        <label class="field__label" for="phone">Phone <span class="optional">(optional)</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field full" data-field>
        <label class="field__label" for="message">Anything you’d like to share or ask? <span class="optional">(optional)</span></label>
        <textarea id="message" name="message" rows="3"></textarea>
        <p class="field__hint">
          You can share questions, preferences, or whether you are considering Chicago pickup or delivery.
        </p>
        <p class="field__error" data-error hidden></p>
      </div>
      <div class="field full" data-field>
        <label class="check">
          <input type="checkbox" name="inquiryAck" value="yes" required aria-required="true" />
          <span>
            I understand that sending this inquiry does not reserve a puppy and that Angel Bulldogs will
            reply using the contact details I provide. <span aria-hidden="true">*</span>
          </span>
        </label>
        <p class="field__error" data-error hidden></p>
      </div>
    </div>
  </fieldset>

  <div>
    <button class="btn btn--primary btn--full-mobile" type="submit">
      <span>Send inquiry</span>
      <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
    <p class="field__hint form-privacy-note">
      We use the information you provide to respond to your inquiry and discuss puppy placement.
      See our <a href="/privacy">Privacy Policy</a>. This inquiry does not subscribe you to the
      availability newsletter.
    </p>
    <div class="prototype-banner" data-form-notice role="status" aria-live="polite"></div>
  </div>
</form>

<script>
  import { parseFormspreeEndpoint } from "../lib/formDelivery";
  import {
    buildPuppyInquiryFormData,
    type PuppyInquiryFields,
  } from "../lib/puppyInquiry";
  import { initPrototypeForm, syncSelectFromQuery } from "../scripts/prototype-form";

  const form = document.querySelector<HTMLFormElement>("[data-application-form]");
  const notice = form?.querySelector<HTMLElement>("[data-form-notice]");
  const puppySelect = form?.querySelector<HTMLSelectElement>("[data-puppy-select]");
  const unknown = form?.querySelector<HTMLElement>("[data-unknown-puppy]");
  const lookingFor = form?.querySelector<HTMLSelectElement>("[data-looking-for]");
  const breedingNote = form?.querySelector<HTMLElement>("[data-breeding-note]");
  const publicEmail = form?.dataset.publicEmail ?? "angelbulldogs7@gmail.com";

  if (form && notice) {
    initPrototypeForm({
      form,
      notice,
      endpoint: parseFormspreeEndpoint(form.dataset.endpoint),
      prototypeMode: form.dataset.prototypeMode === "true",
      successHeading: "Inquiry received",
      unavailableMessage: `Inquiry delivery is not connected yet, so nothing was sent. Please email ${publicEmail} for now.`,
      successMessage:
        "Thank you for reaching out. We'll reply personally with availability, pricing, and next steps. Please check your inbox and spam folder.",
      errorMessage: `Something went wrong and your inquiry was not sent. Your details are still in the form — please try again or email ${publicEmail}.`,
      submit: async (endpoint, liveForm) => {
        const data = new FormData(liveForm);
        const fields: PuppyInquiryFields = {
          fullName: String(data.get("fullName") ?? ""),
          email: String(data.get("email") ?? ""),
          location: String(data.get("location") ?? ""),
          puppyInterest: String(data.get("puppyInterest") ?? ""),
          timing: String(data.get("timing") ?? ""),
          lookingFor: String(data.get("lookingFor") ?? ""),
          phone: String(data.get("phone") ?? ""),
          message: String(data.get("message") ?? ""),
          inquiryAck: data.get("inquiryAck") === "yes",
        };
        return fetch(endpoint, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: buildPuppyInquiryFormData(fields),
        });
      },
    });
  }

  if (puppySelect) {
    syncSelectFromQuery({
      select: puppySelect,
      param: "puppy",
      unknownNotice: unknown ?? undefined,
      // Also accept ?interest=future-litter as an alias for the future-litter option.
      aliases: { interest: "puppy" },
    });
  }

  const syncBreedingNote = () => {
    if (!lookingFor || !breedingNote) return;
    breedingNote.hidden = lookingFor.value !== "breeding-rights";
  };
  lookingFor?.addEventListener("change", syncBreedingNote);
  form?.addEventListener("reset", () => {
    queueMicrotask(syncBreedingNote);
  });
  syncBreedingNote();
</script>
