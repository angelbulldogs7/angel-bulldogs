---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { getPublicEmail, siteConfig } from "../config/site";

const { address, notice } = getPublicEmail();
---

<BaseLayout
  title="Contact Angel Bulldogs | Chicago"
  description="Contact Angel Bulldogs, a Chicago-based French Bulldog program. Ask a general question, or start a short puppy inquiry for availability and pricing."
  path="/contact"
>
  <!-- Legacy /contact?puppy=<slug> → canonical Puppy Inquiry (static-site safe). -->
  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (!params.get("puppy")) return;
      var next = new URL("/application", window.location.origin);
      next.search = params.toString();
      window.location.replace(next.toString());
    })();
  </script>
  <PageHero
    title="Contact"
    lede="For general questions, send a short note here. For availability and pricing, start with a puppy inquiry — it only takes a couple of minutes."
  />
  <section class="section">
    <div class="container split split--2">
      <div>
        <p class="eyebrow">Angel Bulldogs</p>
        <h2>{siteConfig.location}</h2>
        <p>{siteConfig.serviceArea} for approved families.</p>
        <p>Email is our primary public contact method.</p>
        {
          address ? (
            <p>
              <a href={`mailto:${address}`}>{address}</a>
            </p>
          ) : (
            <p>
              <span class="dev-notice">{notice}</span>
            </p>
          )
        }
        <p>
          Looking for a puppy?
          <a href="/application">Start a Puppy Inquiry</a>.
        </p>
        <p class="field__hint">
          <a href="/privacy">Privacy Policy</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
