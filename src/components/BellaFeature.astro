---
import { getDam } from "../data/parents";
import ButtonLink from "./ButtonLink.astro";
import MediaImage from "./MediaImage.astro";

const bella = getDam();
---

<section class="section">
  <div class="container split split--2 reveal" data-reveal>
    {
      bella.portrait && (
        <div class="media-frame aspect-portrait">
          <MediaImage
            src={bella.portrait.src}
            alt={bella.portrait.alt}
            width={bella.portrait.width}
            height={bella.portrait.height}
          />
        </div>
      )
    }
    <div>
      <p class="eyebrow">Bella</p>
      <h2>Our angel, Bella</h2>
      <p>
        Bella came from Serbia and is part of the life we share in Chicago. Her warm, light coat and
        affectionate nature are why we think of her as our angel, and why Angel Bulldogs has its name.
      </p>
      <p>
        This is her first official litter. Read her full story, personality, and the short note about
        how we learned from a friend who breeds French Bulldogs in Serbia.
      </p>
      <div class="cluster">
        <ButtonLink href="/bella">Bella's story</ButtonLink>
      </div>
    </div>
  </div>
</section>
