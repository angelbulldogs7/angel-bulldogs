---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ApplicationForm from "../components/ApplicationForm.astro";
---

<BaseLayout
  title="Puppy Inquiry | Angel Bulldogs"
  description="Start a short puppy inquiry with Angel Bulldogs in Chicago. We’ll follow up personally with availability, pricing, and next steps."
  path="/application"
>
  <PageHero
    eyebrow="Placement"
    title="Puppy Inquiry"
    lede="Start with a few quick details. We'll follow up personally with availability, pricing, and next steps."
  />
  <section class="section">
    <div class="container form-narrow">
      <ApplicationForm />
    </div>
  </section>
</BaseLayout>
