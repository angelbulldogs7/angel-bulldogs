---
import ButtonLink from "./ButtonLink.astro";
import { PROCESS_REFUND_NOTE, PROCESS_STEPS } from "../data/content";

const steps = PROCESS_STEPS.map((step, index) => ({
  num: String(index + 1).padStart(2, "0"),
  ...step,
}));
---

<section class="section section--cream">
  <div class="container">
    <div class="reveal" data-reveal>
      <p class="eyebrow">Next steps</p>
      <h2>From first hello to coming home</h2>
    </div>
    <ol class="process-grid reveal" data-reveal>
      {
        steps.map((step) => (
          <li class="process-card">
            <p class="num">{step.num}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="measure reveal" data-reveal style="margin-top: 1.5rem">
      {PROCESS_REFUND_NOTE}
    </p>
    <p class="cluster reveal" data-reveal style="margin-top: 1rem">
      <ButtonLink href="/faq" variant="secondary">Read the FAQ</ButtonLink>
      <ButtonLink href="/application">Start a Puppy Inquiry</ButtonLink>
    </p>
  </div>
</section>
