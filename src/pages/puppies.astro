---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import LitterIntro from "../components/LitterIntro.astro";
import PuppyGrid from "../components/PuppyGrid.astro";
import { PRICE_LABEL, siteConfig } from "../config/site";
import { getAvailablePuppies } from "../data/puppies";

const available = getAvailablePuppies();
---

<BaseLayout
  title="Available French Bulldog Puppies | Angel Bulldogs"
  description="See currently available French Bulldog puppies from Bella’s first litter at Angel Bulldogs in Chicago. Pricing varies by puppy and is confirmed in a personal reply. Chicago pickup and nationwide delivery for approved families."
  path="/puppies"
>
  <PageHero
    eyebrow={siteConfig.locationShort}
    title="Available Puppies"
    lede={`Bella’s first litter is ready to meet approved families. Every placement begins with a personal conversation, and availability can change. ${PRICE_LABEL} Chicago pickup and nationwide delivery can be discussed for approved families.`}
  />
  <section class="section">
    <div class="container stack-lg">
      <LitterIntro />
      <PuppyGrid puppies={available} />
    </div>
  </section>
</BaseLayout>
